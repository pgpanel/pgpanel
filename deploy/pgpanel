#!/usr/bin/env bash
# PgPanel management CLI — installed to /usr/local/bin/pgpanel
# Developer: Dezső Benedek Péter
# shellcheck disable=SC1091
set -Eeuo pipefail

readonly CONF_FILE="/etc/pgpanel/installer.conf"
readonly DEFAULT_INSTALL_DIR="/opt/pgpanel"
readonly OFFICIAL_REPO="https://github.com/pgpanel/pgpanel.git"

load_conf() {
  if [[ -f "$CONF_FILE" ]]; then
    # shellcheck source=/dev/null
    set -a
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    set +a
  fi
  INSTALL_DIR="${INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
  DATA_DIR="${DATA_DIR:-/var/lib/pgpanel}"
  LOG_DIR="${LOG_DIR:-/var/log/pgpanel}"
  COMPOSE_FILE="${INSTALL_DIR}/deploy/compose.yml"
  INSTALLER="${INSTALL_DIR}/deploy/install.sh"
  if [[ ! -f "$INSTALLER" && -f "$(dirname "$0")/install.sh" ]]; then
    INSTALLER="$(cd "$(dirname "$0")" && pwd)/install.sh"
  fi
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1; then
      exec sudo -E "$0" "$@"
    fi
    echo "Root required" >&2
    exit 1
  fi
}

compose() {
  if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "Compose file not found: $COMPOSE_FILE" >&2
    exit 1
  fi
  (
    cd "$(dirname "$COMPOSE_FILE")"
    if [[ -f "${INSTALL_DIR}/.env" ]]; then
      set -a
      # shellcheck source=/dev/null
      source "${INSTALL_DIR}/.env"
      set +a
    fi
    docker compose -f compose.yml "$@"
  )
}

usage() {
  cat <<'EOF'
PgPanel management CLI
Developer: Dezső Benedek Péter

Usage:
  pgpanel status
  pgpanel start|stop|restart
  pgpanel logs [service]
  pgpanel update              # image-only (pull GHCR, no git)
  pgpanel update --with-host  # also sync compose/Caddy/installer via git
  pgpanel resume              # continue interrupted install (keeps answers)
  pgpanel version             # local + remote version check
  pgpanel repair
  pgpanel configure
  pgpanel backup-test
  pgpanel security-check
  pgpanel uninstall
  pgpanel env-check

EOF
}

cmd_status() {
  echo "=== Compose services ==="
  compose ps || true
  echo ""
  echo "=== Health ==="
  docker run --rm --network pgpanel_frontend curlimages/curl:8.5.0 \
    -fsS http://panel:8080/health 2>/dev/null && echo "panel /health: ok" || echo "panel /health: fail"
  docker run --rm --network pgpanel_frontend curlimages/curl:8.5.0 \
    -fsS http://panel:8080/ready 2>/dev/null && echo "panel /ready: ok" || echo "panel /ready: fail"
  echo ""
  echo "=== Disk ==="
  df -h "$DATA_DIR" 2>/dev/null || df -h /
  echo ""
  if [[ -f "${INSTALL_DIR}/VERSION" ]]; then
    echo "VERSION file: $(tr -d ' \n' <"${INSTALL_DIR}/VERSION")"
  fi
  if [[ -f "${INSTALL_DIR}/.env" ]]; then
    grep -E '^(PGPANEL_VERSION|PGPANEL_IMAGE)=' "${INSTALL_DIR}/.env" 2>/dev/null || true
  fi
}

cmd_version() {
  local local_v remote_v
  local_v="unknown"
  [[ -f "${INSTALL_DIR}/VERSION" ]] && local_v="$(tr -d ' \n' <"${INSTALL_DIR}/VERSION")"
  remote_v="$(curl -fsSL --max-time 15 https://raw.githubusercontent.com/pgpanel/pgpanel/main/VERSION 2>/dev/null | tr -d ' \n' || echo unknown)"
  echo "PgPanel"
  echo "  Developer:     Dezső Benedek Péter"
  echo "  Official repo: ${OFFICIAL_REPO}"
  echo "  Install dir:   ${INSTALL_DIR}"
  echo "  Local version: ${local_v}"
  echo "  Remote main:   ${remote_v}"
  if [[ -d "${INSTALL_DIR}/.git" ]]; then
    echo "  Git commit:    $(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo n/a)"
  fi
  if [[ -f "${INSTALL_DIR}/.env" ]]; then
    grep -E '^(PGPANEL_IMAGE|PGPANEL_VERSION|PGPANEL_UPDATE_CHANNEL)=' "${INSTALL_DIR}/.env" 2>/dev/null || true
  fi
  if [[ "$local_v" != "unknown" && "$remote_v" != "unknown" && "$local_v" != "$remote_v" ]]; then
    echo ""
    echo "Update available: ${local_v} → ${remote_v}"
    echo "Run:  sudo pgpanel update"
  elif [[ "$local_v" == "$remote_v" && "$local_v" != "unknown" ]]; then
    echo ""
    echo "Up to date."
  fi
  docker --version 2>/dev/null || true
  docker compose version 2>/dev/null || true
}

cmd_env_check() {
  local f="${INSTALL_DIR}/.env"
  [[ -f "$f" ]] || { echo "missing .env"; exit 1; }
  local mode
  mode="$(stat -c '%a' "$f" 2>/dev/null || stat -f '%OLp' "$f")"
  echo "path=$f mode=$mode"
  [[ "$mode" == "600" ]] || echo "WARNING: expected 0600"
  for k in PGPANEL_MASTER_KEY DATABASUS_INTERNAL_TOKEN PGPANEL_IMAGE; do
    if grep -q "^${k}=" "$f"; then
      echo "present: $k"
    else
      echo "MISSING: $k"
    fi
  done
}

main() {
  load_conf
  local cmd="${1:-}"
  case "$cmd" in
    status) cmd_status ;;
    start) need_root "$@"; compose up -d --remove-orphans ;;
    stop) need_root "$@"; compose stop ;;
    restart) need_root "$@"; compose restart ;;
    logs) shift; compose logs -f --tail=200 "$@" ;;
    update)
      need_root "$@"
      shift
      # Pass through --with-host / --force-update etc.
      exec bash "$INSTALLER" --mode update "$@"
      ;;
    resume|continue) need_root "$@"; exec bash "$INSTALLER" --mode resume ;;
    version|version-check) cmd_version ;;
    repair) need_root "$@"; exec bash "$INSTALLER" --mode repair ;;
    configure) need_root "$@"; exec bash "$INSTALLER" --mode configure ;;
    backup-test) need_root "$@"; exec bash "$INSTALLER" --mode backup-test ;;
    security-check) need_root "$@"; exec bash "$INSTALLER" --mode security ;;
    uninstall) need_root "$@"; exec bash "$INSTALLER" --mode uninstall ;;
    env-check) cmd_env_check ;;
    -h|--help|help|"") usage; exit 0 ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
