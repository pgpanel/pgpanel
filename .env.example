# =============================================================================
# PgPanel environment example
# Copy to /opt/pgpanel/.env (or project root .env for dev)
# chmod 0600 .env && chown root:root .env
# NEVER commit real secrets. NEVER put secrets on docker compose command line.
# =============================================================================

# ── Core secrets (openssl rand -base64 48) ───────────────────────────────────
PGPANEL_MASTER_KEY=replace-me-min-32-chars-base64
PGPANEL_SESSION_SECRET=replace-me
PGPANEL_CSRF_SECRET=replace-me
PGPANEL_API_SIGNING_SECRET=replace-me
PGPANEL_BOOTSTRAP_TOKEN=optional-one-time-setup-token
PGPANEL_INTERNAL_API_TOKEN=replace-me
PGPANEL_DOCKER_NETWORK_SUFFIX=abcd1234

# ── Runtime ──────────────────────────────────────────────────────────────────
PGPANEL_BIND=0.0.0.0:8080
PGPANEL_DATA_DIR=/var/lib/pgpanel
PGPANEL_STATIC_DIR=/app/static
PGPANEL_DATABASE_URL=sqlite:///var/lib/pgpanel/panel.db?mode=rwc
PGPANEL_COOKIE_SECURE=true
PGPANEL_SESSION_TTL_HOURS=24
PGPANEL_LOGIN_MAX_ATTEMPTS=5
PGPANEL_DOMAIN=db.example.com
CADDY_EMAIL=admin@example.com
PGPANEL_UPDATE_CHANNEL=stable

# Cluster defaults (documentation / future panel settings)
PGPANEL_DEFAULT_PG_VERSION=17
PGPANEL_ALLOWED_PG_VERSIONS=16,17,18
PGPANEL_DEFAULT_CPU=2
PGPANEL_DEFAULT_MEMORY_MB=2048
PGPANEL_DEFAULT_STORAGE_GB=20
PGPANEL_DEFAULT_TIMEZONE=Europe/Budapest
PGPANEL_MAX_CLUSTERS=20
PGPANEL_CONTAINER_PREFIX=pgpanel_pg_
PGPANEL_PUBLIC_PORTS_DEFAULT=false

# ── Databasus ────────────────────────────────────────────────────────────────
ENABLE_DATABASUS=1
DATABASUS_BASE_URL=http://databasus:8000
DATABASUS_INTERNAL_TOKEN=replace-me-same-as-internal-api
DATABASUS_ENCRYPTION_SECRET=replace-me
DATABASUS_ADMIN_EMAIL=admin@example.com
DATABASUS_DOMAIN=backup.db.example.com
DATABASUS_PUBLIC=0
# Pin after verifying upstream release:
# DATABASUS_IMAGE=ghcr.io/databasus/databasus:x.y.z

# ── Backup storage (used by installer probes / future adapters) ──────────────
# Types: s3 | r2 | b2 | hetzner | minio | local | later
BACKUP_STORAGE_TYPE=later
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=1
S3_PREFIX=pgpanel/
S3_TLS_VERIFY=1
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_COUNT=30
BACKUP_FULL_FREQ=daily
BACKUP_INCR_FREQ=hourly
BACKUP_WAL_STREAMING=1
BACKUP_RESTORE_VERIFY=daily

# ── Notifications ────────────────────────────────────────────────────────────
# Types: none | smtp | discord | slack | telegram | webhook
NOTIFY_TYPE=none
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
WEBHOOK_URL=
WEBHOOK_TOKEN=

# ── Admin bootstrap hints (password stored separately if generated) ──────────
PGPANEL_ADMIN_USERNAME=admin
PGPANEL_ADMIN_EMAIL=admin@example.com

# ── Local development overrides ──────────────────────────────────────────────
# PGPANEL_BIND=127.0.0.1:8080
# PGPANEL_DATA_DIR=./data
# PGPANEL_COOKIE_SECURE=false
# PGPANEL_STATIC_DIR=./frontend/build
# DOCKER_HOST=unix:///var/run/docker.sock
